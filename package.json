{
  "name": "dyno-pony",
  "version": "1.1.0",
  "private": true,
  "description": "Fares' agent mode + skill arsenal for DSH: one merged Cordis plugin (38 tools), 14 dynamic skills, prose skills, and the test oracle that keeps docs true.",
  "scripts": {
    "build": "node scripts/merge-plugins.cjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.cjs",
    "test:preflight": "npm run build && node --test tests/preflight.test.cjs",
    "test:count": "npm run build && node scripts/suite-count.cjs",
    "test:count:update": "npm run build && node scripts/suite-count.cjs --update",
    "merge": "npm run build",
    "install": "bash scripts/install.sh",
    "collect": "bash scripts/collect.sh"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=22.19"
  }
}
